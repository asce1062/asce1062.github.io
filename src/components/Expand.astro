---
interface Props {
    title: string
}
const { title } = Astro.props;

---
<section>
    <label class="h-max">
      <input class="peer/showLabel absolute scale-0" type="checkbox" />
      <span id="expand-content" class="block max-h-14 w-full overflow-hidden rounded-lg bg-light-100 px-4 dark:bg-palette-900 py-shadow-lg peer-checked/showLabel:max-h-fit">
        <h3 class="font-retro flex h-14 cursor-pointer items-center justify-between font-bold">
          <span class="flex items-center">
            <i class="icon-music">&nbsp;</i>{title}
          </span>
          <span class="chevron-container">
            <i class="icon-chevron-down chevron-down peer-checked/showLabel:hidden"></i>
            <i class="icon-chevron-up chevron-up hidden peer-checked/showLabel:inline-block"></i>
          </span>
        </h3>
        <slot class = "mb-2 overflow-auto" name="content" />
      </span>
    </label>
  </section>

<style>
  /* Ensure the chevron icons toggle correctly */
  .peer\/showLabel:checked ~ * .chevron-down {
    display: none;
  }
  
  .peer\/showLabel:checked ~ * .chevron-up {
    display: inline-block;
  }
  
  .chevron-up {
    display: none;
  }
  
  .chevron-down {
    display: inline-block;
  }
</style>

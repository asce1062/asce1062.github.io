      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    50% {
      transform: scale(1.02);
      box-shadow: 0 0 0 8px rgba(59, 130, 246, 0.1);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  /* Clean widget styling with fixed positioning */
  #now-playing-collapsed {
    /* Fixed positioning - no transform conflicts */
    position: fixed;
    /* Simple transitions for opacity and scale only */
    transition:
      opacity 0.3s ease,
      scale 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #now-playing-collapsed:hover {
    scale: 1.02;
  }

  #now-playing-card {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);

---

---

<!-- Collapsed Now Playing Widget (always visible when track is playing) -->
<!-- Sleep Timer Button (positioned just above collapsed widget) -->
<div
  id="now-playing-collapsed"
  class="fixed rounded-xl p-md-responsive border bg-light-100/80 dark:bg-palette-900/80 border-palette-800/30 dark:border-palette-300/30 shadow-2xl z-50 cursor-pointer hover:scale-105 opacity-0 pointer-events-none relative"
  style="width: clamp(200px, 20vw, 280px); bottom: clamp(1rem, 2vw, 1.5rem); right: clamp(1rem, 2vw, 1.5rem); transition: opacity 0.3s ease, scale 0.2s cubic-bezier(0.4, 0, 0.2, 1);"
>

  <!-- Track Title - Full width row -->
  <div class="marquee-container overflow-hidden pr-[32px] mb-xs-responsive">
    <h4
      class="text-palette-900 dark:text-white font-bold text-xs-responsive now-playing-title-collapsed font-retro marquee-text"
    >
      No track playing
    </h4>
  </div>

  <!-- Headphones, Album Name, and Expand Button -->
  <div class="flex items-center gap-sm-responsive pr-[32px]">
    <i
      class="icon-headphones text-palette-500 dark:text-palette-500 icon-md now-playing-format-collapsed"
    ></i>
    <div class="flex-1 min-w-0 overflow-hidden">
      <div class="marquee-container">
        <p
          class="text-palette-900 dark:text-gray-400 text-xs-responsive now-playing-album-collapsed font-proto marquee-text"
        >
          Select a track to begin
        </p>
      </div>
    </div>
    <button
      id="expand-now-playing"
      class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
    >
      <i class="icon-chevron-up icon-sm"></i>
    </button>
  </div>

  <!-- Play/Pause button positioned absolutely -->
  <button
    id="collapsed-play-pause"
    class="absolute top-[50%] transform -translate-y-1/2 right-[0px] text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors pointer-events-auto"
    style="top: calc(50% + 2px);"
  >
    <i class="icon-play-fill icon-md collapsed-play-icon"></i>
    <i class="icon-pause icon-md collapsed-pause-icon" style="display: none;"></i>
  </button>

  <!-- Mini Progress Bar -->
  <div class="mt-sm-responsive">
    <div class="mini-progress-container-collapsed bg-light-200 dark:bg-palette-900 rounded-full h-[2px] cursor-pointer">
      <div
        class="mini-progress-bar-collapsed bg-gradient-to-r from-palette-800 to-palette-300 dark:from-palette-300 dark:to-palette-500 h-full rounded-full transition-all duration-200"
        style="width: 0%"
      >
      </div>
    </div>
  </div>
</div>

<div
  id="sleep-timer-button"
  class="fixed z-50 opacity-0 pointer-events-none transition-all duration-300 flex justify-end pr-md-responsive"
  style="width: clamp(200px, 20vw, 280px); bottom: clamp(1rem, 2vw, 1.5rem); right: clamp(-1rem, -2vw, -1.5rem); transform: translateY(-220%) translateY(-0.5rem);"
>
  <button
    id="sleep-timer-toggle"
    class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
    title="Sleep Timer"
  >
    <i class="icon-stopwatch icon-md"></i>
  </button>
</div>

<!-- Sleep Timer Popup -->
<div
  id="sleep-timer-popup"
  class="fixed z-50 hidden transition-all duration-300 transform translate-y-full"
  style="width: clamp(200px, 20vw, 280px); bottom: clamp(1rem, 2vw, 1.5rem); right: clamp(1rem, 2vw, 1.5rem);"
>
  <div class="bg-light-100/80 dark:bg-palette-900/80 rounded-2xl border border-palette-800/30 dark:border-palette-300/30 shadow-2xl backdrop-blur-sm overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between p-lg-responsive border-b border-palette-800/20 dark:border-palette-300/20">
      <h3 class="text-lg-responsive font-retro text-palette-900 dark:text-white">Sleep Timer</h3>
      <button
        id="sleep-timer-close"
        class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
      >
        <i class="icon-x icon-md"></i>
      </button>
    </div>

    <!-- Timer Options -->
    <div class="p-lg-responsive space-y-sm-responsive">
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="1"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        1 minute
      </button>
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="5"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        5 minutes
      </button>
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="10"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        10 minutes
      </button>
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="15"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        15 minutes
      </button>
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="20"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        20 minutes
      </button>
      <button
        class="sleep-timer-option w-full text-left p-md-responsive rounded-lg hover:bg-palette-800/10 dark:hover:bg-palette-300/10 transition-colors text-palette-900 dark:text-white font-proto"
        data-minutes="30"
      >
        <i class="icon-clock icon-sm mr-sm-responsive text-palette-500"></i>
        30 minutes
      </button>

    </div>
  </div>
</div>

<!-- Active Sleep Timer Modal -->
<div
  id="active-timer-modal"
  class="fixed z-50 hidden transition-all duration-300 transform translate-y-full"
  style="width: clamp(200px, 20vw, 280px); bottom: clamp(1rem, 2vw, 1.5rem); right: clamp(1rem, 2vw, 1.5rem);"
>
  <div class="bg-light-100/80 dark:bg-palette-900/80 rounded-2xl border border-palette-800/30 dark:border-palette-300/30 shadow-2xl backdrop-blur-sm overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between p-lg-responsive border-b border-palette-800/20 dark:border-palette-300/20">
      <h3 class="text-lg-responsive font-retro text-palette-900 dark:text-white">Sleep Timer</h3>
      <button
        id="active-timer-close"
        class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
      >
        <i class="icon-x icon-md"></i>
      </button>
    </div>

    <!-- Active Timer Content -->
    <div class="p-lg-responsive">
      <div class="flex items-center justify-between p-md-responsive rounded-lg bg-palette-800/5 dark:bg-palette-300/5">
        <div>
          <div class="text-palette-900 dark:text-white font-proto text-sm-responsive">Timer Active</div>
          <div id="timer-countdown" class="text-palette-500 dark:text-palette-500 font-retro text-lg-responsive">--:--</div>
        </div>
        <button
          id="cancel-timer"
          class="px-md-responsive py-sm-responsive bg-palette-800/10 dark:bg-palette-300/10 hover:bg-palette-800/20 dark:hover:bg-palette-300/20 rounded-lg text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors text-sm-responsive font-proto"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Expanded Now Playing Widget -->
<div id="now-playing-expanded" class="fixed inset-0 bg-black/50 z-50 hidden">
  <!-- Compact Card Layout -->
  <div
    class="fixed bottom-lg-responsive left-1/2 transform -translate-x-1/2 bg-light-100/80 dark:bg-palette-900/80 rounded-2xl border border-palette-800/30 dark:border-palette-300/30 shadow-2xl translate-y-full transition-transform duration-300 overflow-hidden"
    style="width: clamp(280px, 25vw, 320px); max-height: 80vh;"
    id="now-playing-card"
  >
    <!-- Album Art Section -->
    <div class="relative">
      <div class="aspect-square relative overflow-hidden">
        <!-- Album Cover Image -->
        <img
          class="w-full h-full object-cover now-playing-album-art"
          src="/art/default-cover.png"
          alt="Album cover"
          loading="lazy"
        />

        <!-- Overlay for better text visibility -->
        <div class="absolute inset-0 bg-black/20"></div>

        <!-- Close Button (positioned at top-right corner) -->
        <button
          id="collapse-now-playing"
          class="absolute top-[4px] right-[4px] bg-black/60 rounded-full w-8 h-8 flex items-center justify-center text-white hover:text-gray-300 transition-colors"
        >
          <i class="icon-x icon-md"></i>
        </button>
      </div>
    </div>

    <!-- Content Section -->
    <div class="p-lg-responsive">
      <!-- Track Title -->
      <div class="marquee-container mb-xs-responsive overflow-hidden">
        <h4
          class="text-lg-responsive font-retro text-palette-900 dark:text-white now-playing-title-expanded marquee-text"
        >
          No track playing
        </h4>
      </div>

      <!-- Album Title -->
      <div class="marquee-container mb-lg-responsive overflow-hidden">
        <p
          class="text-sm-responsive text-palette-900 dark:text-gray-400 now-playing-album-expanded marquee-text font-proto"
        >
          Select a track to begin
        </p>
      </div>

      <!-- Controls Section (replacing description area) -->
      <div class="space-y-lg-responsive">
        <!-- Media Controls -->
        <div class="flex items-center justify-center gap-lg-responsive">
          <button
            id="expanded-prev"
            class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
          >
            <i class="icon-skip-backward icon-lg"></i>
          </button>

          <button
            id="expanded-play-pause"
            class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-all duration-200 transform hover:scale-110"
          >
            <i class="icon-play-fill icon-xl expanded-play-icon"></i>
            <i class="icon-pause icon-xl expanded-pause-icon" style="display: none;"></i>
          </button>

          <button
            id="expanded-next"
            class="text-palette-800 dark:text-palette-300 hover:text-palette-300 dark:hover:text-palette-400 transition-colors"
          >
            <i class="icon-skip-forward icon-lg"></i>
          </button>
        </div>

        <!-- Volume Control with Repeat Button -->
        <div class="flex items-center gap-sm-responsive">
          <i class="icon-volume-up icon-sm text-palette-800 dark:text-palette-500"></i>
          <input
            type="range"
            class="expanded-volume-slider flex-1 bg-light-200 dark:bg-palette-900 rounded-lg appearance-none cursor-pointer h-[4px]"
            min="0"
            max="100"
            value="70"
          />
          <span
            class="text-xs-responsive text-palette-900 dark:text-gray-400 font-proto w-[2rem] text-right expanded-volume-display"
            >70%</span
          >

          <!-- Repeat Button moved here -->
          <button
            id="expanded-loop"
            class="text-palette-800 dark:text-palette-800 hover:text-palette-800 dark:hover:text-palette-400 ml-sm-responsive"
            title="Loop Track"
          >
            <i class="icon-repeat icon-md expanded-loop-icon"></i>
            <i class="icon-repeat-1 icon-md expanded-loop-one-icon" style="display: none;"></i>
          </button>
        </div>

        <!-- Progress Section -->
        <div>
          <div
            class="flex items-center justify-between text-xs-responsive text-palette-900 dark:text-gray-400 mb-xs-responsive font-proto"
          >
            <span class="expanded-current-time">0:00</span>
            <span class="expanded-total-time">0:00</span>
          </div>
          <div
            class="expanded-progress-container bg-light-200 dark:bg-palette-900 rounded-full h-[6px] cursor-pointer"
          >
            <div
              class="expanded-progress-bar bg-gradient-to-r from-palette-800 to-palette-300 dark:from-palette-300 dark:to-palette-500 h-full rounded-full transition-all duration-200"
              style="width: 0%"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Release Date -->
      <div
        class="text-palette-900 dark:text-gray-500 text-xs-responsive font-proto mt-lg-responsive now-playing-release-date"
      >
        <!-- Release date will be populated dynamically -->
      </div>
    </div>
  </div>
</div>

<script>
  import { musicPlayer } from '../utils/musicPlayer';
  import { nowPlayingManager } from '../utils/nowPlayingManager';
  import type { PlaybackState } from '../utils/musicPlayer';

  class NowPlayingWidget {
    private collapsedElement: HTMLElement;
    private expandedElement: HTMLElement;
    private expandedContainer: HTMLElement;
    private sleepTimerButton: HTMLElement;
    private sleepTimerPopup: HTMLElement;
    private activeTimerModal: HTMLElement;
    private isVisible = false;
    private isExpanded = false;
    private isSleepTimerExpanded = false;
    private isActiveTimerVisible = false;
    private wasActiveTimerVisibleBeforeExpand = false;
    private footerObserver: IntersectionObserver | null = null;
    private sleepTimerInterval: number | null = null;
    private sleepTimerEndTime: number | null = null;
    private lastTimerDuration: number | null = null;
    private sleepTimerPaused = false;
    private sleepTimerPausedAt: number | null = null;

    constructor() {
      this.collapsedElement = document.getElementById('now-playing-collapsed') as HTMLElement;
      this.expandedElement = document.getElementById('now-playing-expanded') as HTMLElement;
      this.expandedContainer = document.getElementById('now-playing-card') as HTMLElement;
      this.sleepTimerButton = document.getElementById('sleep-timer-button') as HTMLElement;
      this.sleepTimerPopup = document.getElementById('sleep-timer-popup') as HTMLElement;
      this.activeTimerModal = document.getElementById('active-timer-modal') as HTMLElement;

      if (!this.collapsedElement || !this.expandedElement) return;

      this.init();
    }

    private init() {
      this.setupEventListeners();
      this.setupSleepTimerEventListeners();
      this.setupFooterOverlapPrevention();
      this.bindMusicPlayerEvents();

      // Initialize with current state
      const state = musicPlayer.getState();
      this.updateFromState(state);

      // Restore sleep timer if it was running
      this.restoreSleepTimer();
    }

    private setupEventListeners() {
      // Expand/Collapse controls
      const expandBtn = document.getElementById('expand-now-playing');
      const collapseBtn = document.getElementById('collapse-now-playing');

      expandBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.expand();
      });

      collapseBtn?.addEventListener('click', () => this.collapse());

      // Collapsed play/pause button
      const collapsedPlayPauseBtn = document.getElementById('collapsed-play-pause');
      collapsedPlayPauseBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.togglePlayPause();
      });

      // Click on collapsed widget to expand
      this.collapsedElement?.addEventListener('click', () => this.expand());

      // Click outside expanded widget to collapse
      this.expandedElement?.addEventListener('click', (e) => {
        if (e.target === this.expandedElement) {
          this.collapse();
        }
      });

      // Media controls
      const expandedPlayPause = document.getElementById('expanded-play-pause');
      const expandedPrev = document.getElementById('expanded-prev');
      const expandedNext = document.getElementById('expanded-next');
      const expandedLoop = document.getElementById('expanded-loop');

      expandedPlayPause?.addEventListener('click', () => this.togglePlayPause());
      expandedPrev?.addEventListener('click', () => nowPlayingManager.previousTrack());
      expandedNext?.addEventListener('click', () => nowPlayingManager.nextTrack());
      expandedLoop?.addEventListener('click', () => nowPlayingManager.toggleLoop());

      // Progress bars
      const collapsedProgressContainer = this.collapsedElement?.querySelector(
        '.mini-progress-container-collapsed'
      );
      const expandedProgressContainer = this.expandedElement?.querySelector(
        '.expanded-progress-container'
      );

      collapsedProgressContainer?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.handleProgressClick(e);
      });
      expandedProgressContainer?.addEventListener('click', (e) => this.handleProgressClick(e));

      // Volume control
      const expandedVolumeSlider = this.expandedElement?.querySelector(
        '.expanded-volume-slider'
      ) as HTMLInputElement;
      expandedVolumeSlider?.addEventListener('input', (e) => {
        const volume = parseInt((e.target as HTMLInputElement).value) / 100;
        nowPlayingManager.setVolume(volume);
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
          return;
        }

        switch (e.key) {
          case ' ':
            e.preventDefault();
            this.togglePlayPause();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            nowPlayingManager.previousTrack();
            break;
          case 'ArrowRight':
            e.preventDefault();
            nowPlayingManager.nextTrack();
            break;
          case 'l':
          case 'L':
            e.preventDefault();
            nowPlayingManager.toggleLoop();
            break;
          case 'Escape':
            if (this.isExpanded) {
              e.preventDefault();
              this.collapse();
            }
            break;
        }
      });
    }

    private setupSleepTimerEventListeners() {
      // Sleep timer toggle button
      const sleepTimerToggle = document.getElementById('sleep-timer-toggle');
      sleepTimerToggle?.addEventListener('click', () => this.toggleSleepTimer());

      // Sleep timer close button (just close popup, don't affect timer)
      const sleepTimerClose = document.getElementById('sleep-timer-close');
      sleepTimerClose?.addEventListener('click', () => this.closeSleepTimer());

      // Sleep timer options
      const sleepTimerOptions = document.querySelectorAll('.sleep-timer-option');
      sleepTimerOptions.forEach(option => {
        option.addEventListener('click', (e) => {
          const minutes = parseInt((e.currentTarget as HTMLElement).dataset.minutes || '0');
          this.selectSleepTimer(minutes);
        });
      });

      // Cancel timer button
      const cancelTimer = document.getElementById('cancel-timer');
      cancelTimer?.addEventListener('click', () => this.cancelSleepTimer());

      // Active timer modal close button (just minimize, don't cancel timer)
      const activeTimerClose = document.getElementById('active-timer-close');
      activeTimerClose?.addEventListener('click', () => this.minimizeActiveTimerModal());

      // Click outside functionality for sleep timer popup (but not active timer modal)
      document.addEventListener('click', (e) => {
        if (this.isSleepTimerExpanded && this.sleepTimerPopup) {
          const target = e.target as HTMLElement;

          // Check if click is outside the popup and not on the sleep timer button
          if (!this.sleepTimerPopup.contains(target) &&
              !this.sleepTimerButton?.contains(target)) {
            this.closeSleepTimer();
          }
        }
      });
    }

    private bindMusicPlayerEvents() {
      // Listen to music player service events
      musicPlayer.onTrackStarted((event) => {
        const { track, album } = event.detail;
        this.updateTrackInfo(track, album);
        this.show();
      });

      musicPlayer.onStateChanged((event) => {
        this.updateFromState(event.detail.state);
      });

      musicPlayer.onProgressUpdated((event) => {
        const { currentTime, duration, percentage } = event.detail;
        this.updateProgress(currentTime, duration, percentage);
      });

      musicPlayer.onVolumeChanged((event) => {
        this.updateVolumeDisplay(Math.round(event.detail.volume * 100));
      });

      musicPlayer.onLoopChanged((event) => {
        this.updateLoopButton(event.detail.isLooping);
      });

      musicPlayer.onTrackChanged((event) => {
        const { track, album } = event.detail;
        this.updateTrackInfo(track, album);
      });

      // Listen for music pause/resume to control sleep timer
      musicPlayer.onTrackPaused(() => {
        this.pauseSleepTimer();
      });

      musicPlayer.onTrackResumed(() => {
        this.resumeSleepTimer();
      });

      // Also listen to state changes to catch play/pause
      musicPlayer.onStateChanged((event) => {
        const state = event.detail.state;
        if (this.sleepTimerEndTime && !this.sleepTimerPaused) {
          if (!state.isPlaying) {
            this.pauseSleepTimer();
          }
        } else if (this.sleepTimerPaused && state.isPlaying) {
          this.resumeSleepTimer();
        }
      });
    }

    private setupFooterOverlapPrevention() {
      // Create intersection observer to detect when footer is visible
      this.footerObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((_entry) => {
            this.updateWidgetPosition();
          });
        },
        {
          root: null,
          rootMargin: '0px',
          threshold: 0.1,
        }
      );

      // Observe the footer element
      const footer = document.querySelector('footer');
      if (footer && this.footerObserver) {
        this.footerObserver.observe(footer);
      }

      // Also listen for scroll events
      let scrollTimeout: number | null = null;
      window.addEventListener('scroll', () => {
        if (scrollTimeout) {
          clearTimeout(scrollTimeout);
        }
        scrollTimeout = window.setTimeout(() => {
          this.updateWidgetPosition();
        }, 10);
      });

      window.addEventListener('resize', () => {
        this.updateWidgetPosition();
      });
    }


    private updateWidgetPosition() {
      if (!this.collapsedElement || !this.isVisible || this.isExpanded) return;

      const footer = document.querySelector('footer');
      if (!footer) return;

      const footerRect = footer.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const margin = 16;

      let maxBottom = margin;
      if (footerRect.top < viewportHeight) {
        const footerVisibleHeight = viewportHeight - footerRect.top;
        maxBottom = footerVisibleHeight + margin + 10;
      }

      // Update collapsed widget position
      this.collapsedElement.style.bottom = `${maxBottom}px`;
      this.collapsedElement.style.transition =
        'bottom 0.3s ease, opacity 0.3s ease, scale 0.2s cubic-bezier(0.4, 0, 0.2, 1)';

      // Update sleep timer button position to match (maintain your custom positioning while respecting footer)
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.bottom = `${maxBottom}px`;
        this.sleepTimerButton.style.transition = 'bottom 0.3s ease, opacity 0.3s ease';
      }

      // Update sleep timer popup position to match (maintaining the increased margin)
      if (this.sleepTimerPopup) {
        // Add the popup's extra margin (10rem difference from the base margin)
        const popupMargin = maxBottom + 165; // 10rem = 160px
        this.sleepTimerPopup.style.bottom = `${popupMargin}px`;
        this.sleepTimerPopup.style.transition = 'bottom 0.3s ease, transform 0.3s ease';
      }

      // Update active timer modal position to match
      if (this.activeTimerModal) {
        const popupMargin = maxBottom + 165; // Same positioning as sleep timer popup
        this.activeTimerModal.style.bottom = `${popupMargin}px`;
        this.activeTimerModal.style.transition = 'bottom 0.3s ease, transform 0.3s ease';
      }
    }

    private updateFromState(state: PlaybackState) {
      if (state.currentTrack && state.currentAlbum) {
        this.updateTrackInfo(state.currentTrack, state.currentAlbum);
        this.updatePlayButton(state.isPlaying);
        this.updateLoopButton(state.isLooping);
        this.updateVolumeSlider(state.volume);

        if (state.isVisible) {
          this.show();
        }
      } else if (this.isVisible) {
        this.hide();
      }
    }

    private updateTrackInfo(track: any, album: any) {
      // Update collapsed widget
      const collapsedTitle = this.collapsedElement?.querySelector('.now-playing-title-collapsed');
      const collapsedAlbum = this.collapsedElement?.querySelector('.now-playing-album-collapsed');

      if (collapsedTitle) {
        collapsedTitle.textContent = track.title || 'Unknown Track';
        nowPlayingManager.setupMarquee(collapsedTitle as HTMLElement);
      }
      if (collapsedAlbum) {
        collapsedAlbum.textContent = album.title || 'Unknown Album';
        nowPlayingManager.setupMarquee(collapsedAlbum as HTMLElement);
      }

      // Update expanded widget
      const expandedTitle = this.expandedElement?.querySelector('.now-playing-title-expanded');
      const expandedAlbum = this.expandedElement?.querySelector('.now-playing-album-expanded');
      const expandedAlbumArt = this.expandedElement?.querySelector(
        '.now-playing-album-art'
      ) as HTMLImageElement;
      const expandedReleaseDate = this.expandedElement?.querySelector('.now-playing-release-date');

      if (expandedTitle) {
        expandedTitle.textContent = track.title || 'Unknown Track';
        nowPlayingManager.setupMarquee(expandedTitle as HTMLElement);
      }
      if (expandedAlbum) {
        expandedAlbum.textContent = album.title || 'Unknown Album';
        nowPlayingManager.setupMarquee(expandedAlbum as HTMLElement);
      }

      // Update album art
      if (expandedAlbumArt && album) {
        expandedAlbumArt.src = album.coverArt || '/art/default-cover.png';
        expandedAlbumArt.alt = `${album.title} album cover`;
      }

      // Update release date
      if (expandedReleaseDate && album) {
        const releaseDate = new Date(album.releaseDate).toLocaleDateString();
        expandedReleaseDate.textContent = `Released ${releaseDate}`;
      }
    }


    private updateProgress(currentTime: number, duration: number, percentage: number) {
      // Update collapsed progress bar
      const collapsedProgressBar = this.collapsedElement?.querySelector(
        '.mini-progress-bar-collapsed'
      ) as HTMLElement;
      if (collapsedProgressBar) {
        collapsedProgressBar.style.width = `${percentage}%`;
      }

      // Update expanded progress bar
      const expandedProgressBar = this.expandedElement?.querySelector(
        '.expanded-progress-bar'
      ) as HTMLElement;
      const expandedCurrentTime = this.expandedElement?.querySelector('.expanded-current-time');
      const expandedTotalTime = this.expandedElement?.querySelector('.expanded-total-time');

      if (expandedProgressBar) {
        expandedProgressBar.style.width = `${percentage}%`;
      }
      if (expandedCurrentTime) {
        expandedCurrentTime.textContent = this.formatTime(currentTime);
      }
      if (expandedTotalTime) {
        expandedTotalTime.textContent = this.formatTime(duration);
      }
    }

    private updatePlayButton(isPlaying: boolean) {
      // Update expanded widget play/pause button
      const expandedPlayIcon = this.expandedElement?.querySelector(
        '.expanded-play-icon'
      ) as HTMLElement;
      const expandedPauseIcon = this.expandedElement?.querySelector(
        '.expanded-pause-icon'
      ) as HTMLElement;

      // Update collapsed widget play/pause button
      const collapsedPlayIcon = this.collapsedElement?.querySelector(
        '.collapsed-play-icon'
      ) as HTMLElement;
      const collapsedPauseIcon = this.collapsedElement?.querySelector(
        '.collapsed-pause-icon'
      ) as HTMLElement;

      if (isPlaying) {
        // Show pause icons
        if (expandedPlayIcon) expandedPlayIcon.style.display = 'none';
        if (expandedPauseIcon) expandedPauseIcon.style.display = 'inline-block';
        if (collapsedPlayIcon) collapsedPlayIcon.style.display = 'none';
        if (collapsedPauseIcon) collapsedPauseIcon.style.display = 'inline-block';
      } else {
        // Show play icons
        if (expandedPlayIcon) expandedPlayIcon.style.display = 'inline-block';
        if (expandedPauseIcon) expandedPauseIcon.style.display = 'none';
        if (collapsedPlayIcon) collapsedPlayIcon.style.display = 'inline-block';
        if (collapsedPauseIcon) collapsedPauseIcon.style.display = 'none';
      }
    }

    private updateLoopButton(isLooping: boolean) {
      const loopIcon = this.expandedElement?.querySelector('.expanded-loop-icon') as HTMLElement;
      const loopOneIcon = this.expandedElement?.querySelector(
        '.expanded-loop-one-icon'
      ) as HTMLElement;
      const loopBtn = this.expandedElement?.querySelector('#expanded-loop');

      if (isLooping) {
        if (loopIcon) loopIcon.style.display = 'none';
        if (loopOneIcon) loopOneIcon.style.display = 'inline-block';

        if (loopBtn) {
          loopBtn.classList.remove('text-palette-800', 'dark:text-palette-300');
          loopBtn.classList.add('text-palette-800', 'dark:text-palette-400');
          loopBtn.setAttribute('title', 'Loop Track (Active)');
        }
      } else {
        if (loopIcon) loopIcon.style.display = 'inline-block';
        if (loopOneIcon) loopOneIcon.style.display = 'none';

        if (loopBtn) {
          loopBtn.classList.add('text-palette-800', 'dark:text-palette-300');
          loopBtn.classList.remove('text-palette-800', 'dark:text-palette-400');
          loopBtn.setAttribute('title', 'Loop Track');
        }
      }
    }

    private updateVolumeSlider(volume: number) {
      const volumeSlider = this.expandedElement?.querySelector(
        '.expanded-volume-slider'
      ) as HTMLInputElement;
      if (volumeSlider) {
        volumeSlider.value = (volume * 100).toString();
        this.updateVolumeDisplay(Math.round(volume * 100));
      }
    }

    private updateVolumeDisplay(volumePercent: number) {
      const volumeDisplay = this.expandedElement?.querySelector('.expanded-volume-display');
      if (volumeDisplay) {
        volumeDisplay.textContent = `${volumePercent}%`;
      }
    }

    private togglePlayPause() {
      nowPlayingManager.togglePlayPause();
    }

    private handleProgressClick(event: Event) {
      const progressContainer = event.currentTarget as HTMLElement;
      const rect = progressContainer.getBoundingClientRect();
      const x = (event as MouseEvent).clientX - rect.left;
      const percentage = x / rect.width;
      const state = musicPlayer.getState();

      if (state.duration && !isNaN(state.duration)) {
        nowPlayingManager.seek(percentage);
      }
    }


    private show() {
      if (this.isVisible) return;

      this.isVisible = true;
      this.collapsedElement.style.opacity = '1';
      this.collapsedElement.style.pointerEvents = 'auto';

      // Show sleep timer button when collapsed widget is visible (only if active timer modal is not shown)
      if (this.sleepTimerButton && !this.isExpanded && !this.isActiveTimerVisible) {
        this.sleepTimerButton.style.opacity = '1';
        this.sleepTimerButton.style.pointerEvents = 'auto';
      }

      this.updateWidgetPosition();
    }

    private hide() {
      if (!this.isVisible) return;

      this.isVisible = false;
      this.collapsedElement.style.opacity = '0';
      this.collapsedElement.style.pointerEvents = 'none';

      // Hide sleep timer button when widget is hidden
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.opacity = '0';
        this.sleepTimerButton.style.pointerEvents = 'none';
      }
    }

    private expand() {
      if (this.isExpanded) return;

      this.isExpanded = true;

      // Remember if active timer modal was visible before expanding
      this.wasActiveTimerVisibleBeforeExpand = this.isActiveTimerVisible;

      this.collapsedElement.style.opacity = '0';
      this.collapsedElement.style.pointerEvents = 'none';
      this.expandedElement?.classList.remove('hidden');

      // Hide sleep timer button when expanding (it's tied to collapsed widget)
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.opacity = '0';
        this.sleepTimerButton.style.pointerEvents = 'none';
      }

      // Also close the sleep timer popup if it's open
      this.closeSleepTimer();

      // Hide the active timer modal if it's open
      if (this.isActiveTimerVisible) {
        this.hideActiveTimerModal();
      }

      setTimeout(() => {
        this.expandedContainer?.classList.remove('translate-y-full');
        this.expandedContainer?.classList.add('translate-y-0');
      }, 10);
    }

    private collapse() {
      if (!this.isExpanded) return;

      this.isExpanded = false;
      this.expandedContainer?.classList.add('translate-y-full');
      this.expandedContainer?.classList.remove('translate-y-0');

      setTimeout(() => {
        this.expandedElement?.classList.add('hidden');

        if (this.isVisible) {
          this.collapsedElement.style.opacity = '1';
          this.collapsedElement.style.pointerEvents = 'auto';

          // Check if there's an active sleep timer running OR if it was visible before expand OR if it's completed with restart option
          const countdown = document.getElementById('timer-countdown');
          const hasActiveTimer = countdown && countdown.textContent !== '--:--' && countdown.textContent !== '';
          const hasRestartOption = countdown && countdown.textContent === "Time's up!";
          const shouldShowActiveTimer = hasActiveTimer || hasRestartOption || this.wasActiveTimerVisibleBeforeExpand;

          if (shouldShowActiveTimer) {
            // Show the active timer modal when returning to collapsed view
            this.showActiveTimerModal();
          } else {
            // Show sleep timer button when returning to collapsed view (only if no active timer)
            if (this.sleepTimerButton) {
              this.sleepTimerButton.style.opacity = '1';
              this.sleepTimerButton.style.pointerEvents = 'auto';
            }
          }

          // Reset the memory flag
          this.wasActiveTimerVisibleBeforeExpand = false;

          this.updateWidgetPosition();
        }
      }, 300);
    }

    private toggleSleepTimer() {
      if (this.isSleepTimerExpanded) {
        this.closeSleepTimer();
      } else {
        // Check if there's an active timer running - if so, show the active timer modal
        const countdown = document.getElementById('timer-countdown');
        const hasActiveTimer = countdown && countdown.textContent !== '--:--' && countdown.textContent !== '';

        if (hasActiveTimer) {
          this.showActiveTimerModal();
        } else {
          this.openSleepTimer();
        }
      }
    }

    private openSleepTimer() {
      if (!this.sleepTimerPopup) return;

      this.isSleepTimerExpanded = true;
      this.sleepTimerPopup.classList.remove('hidden');

      // Hide the sleep timer button when popup is shown
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.opacity = '0';
        this.sleepTimerButton.style.pointerEvents = 'none';
      }

      setTimeout(() => {
        this.sleepTimerPopup.classList.remove('translate-y-full');
        this.sleepTimerPopup.classList.add('translate-y-0');
      }, 10);
    }

    private closeSleepTimer() {
      if (!this.sleepTimerPopup || !this.isSleepTimerExpanded) return;

      this.isSleepTimerExpanded = false;
      this.sleepTimerPopup.classList.add('translate-y-full');
      this.sleepTimerPopup.classList.remove('translate-y-0');

      // Show the sleep timer button when popup is closed (only if no active timer modal)
      if (this.sleepTimerButton && this.isVisible && !this.isExpanded && !this.isActiveTimerVisible) {
        this.sleepTimerButton.style.opacity = '1';
        this.sleepTimerButton.style.pointerEvents = 'auto';
      }

      setTimeout(() => {
        this.sleepTimerPopup.classList.add('hidden');
      }, 300);
    }

    private selectSleepTimer(minutes: number) {
      console.log(`🛌 Sleep timer set for ${minutes} minutes`);

      // Store the duration for potential restart
      this.lastTimerDuration = minutes;

      // Start the actual sleep timer
      this.startSleepTimer(minutes);

      // Smooth transition: close popup and show modal with coordinated timing
      this.transitionToActiveTimer();
    }

    private cancelSleepTimer() {
      const cancelButton = document.getElementById('cancel-timer');
      const isRestart = cancelButton?.textContent?.trim() === 'Restart';

      if (isRestart) {
        // Restart functionality - restart the same duration
        console.log('🛌 Restarting sleep timer with same duration');

        if (this.lastTimerDuration) {
          // Start the timer again with the same duration
          this.startSleepTimer(this.lastTimerDuration);

          // Resume music playback using the same logic as the widget's togglePlayPause
          const state = musicPlayer.getState();
          if (state.currentTrack && state.currentAlbum && !state.isPlaying) {
            // Use the centralized toggle play/pause logic to ensure consistent behavior
            this.togglePlayPause();
          }

          // Keep the active timer modal visible since we just restarted the timer
          // The modal will continue to show the countdown

          console.log(`🛌 Restarted ${this.lastTimerDuration} minute timer and resumed music`);
        } else {
          console.warn('🛌 No previous timer duration found, cannot restart');
          // Fallback: reset button and show error in countdown
          this.updateTimerButton(false);
          const countdown = document.getElementById('timer-countdown');
          if (countdown) {
            countdown.textContent = 'Error';
          }
        }
      } else {
        // Cancel functionality
        console.log('🛌 Sleep timer cancelled');

        // Stop the timer
        this.stopSleepTimer();

        // Clear the countdown display
        const countdown = document.getElementById('timer-countdown');
        if (countdown) {
          countdown.textContent = '--:--';
        }

        // Reset button to Cancel
        this.updateTimerButton(false);

        // Hide the modal and show the sleep timer button
        this.hideActiveTimerModal();
      }
    }

    private showActiveTimerModal() {
      if (!this.activeTimerModal) return;

      this.isActiveTimerVisible = true;
      this.activeTimerModal.classList.remove('hidden');

      // Start with invisible state for smooth animation
      this.activeTimerModal.style.opacity = '0';
      this.activeTimerModal.style.transition = 'opacity 0.3s ease, transform 0.3s ease';

      // Hide the sleep timer button when active timer modal is shown
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.opacity = '0';
        this.sleepTimerButton.style.pointerEvents = 'none';
      }

      setTimeout(() => {
        this.activeTimerModal.classList.remove('translate-y-full');
        this.activeTimerModal.classList.add('translate-y-0');
        this.activeTimerModal.style.opacity = '1';
      }, 10);
    }

    private hideActiveTimerModal() {
      if (!this.activeTimerModal || !this.isActiveTimerVisible) return;

      this.isActiveTimerVisible = false;

      // Use the same smooth animation as now playing widget
      this.activeTimerModal.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      this.activeTimerModal.style.opacity = '0';
      this.activeTimerModal.classList.add('translate-y-full');
      this.activeTimerModal.classList.remove('translate-y-0');

      // Show the sleep timer button when active timer modal is hidden
      if (this.sleepTimerButton && this.isVisible && !this.isExpanded) {
        this.sleepTimerButton.style.opacity = '1';
        this.sleepTimerButton.style.pointerEvents = 'auto';
      }

      setTimeout(() => {
        this.activeTimerModal.classList.add('hidden');
        // Reset styles for next use
        this.activeTimerModal.style.opacity = '';
        this.activeTimerModal.style.transition = '';
      }, 300);
    }

    private minimizeActiveTimerModal() {
      // Just hide the modal but keep the timer running
      this.hideActiveTimerModal();
      // TODO: When timer functionality is implemented, timer should continue running in background
      console.log('🛌 Sleep timer modal minimized - timer continues running');
    }

    private transitionToActiveTimer() {
      if (!this.sleepTimerPopup || !this.activeTimerModal) return;

      this.isSleepTimerExpanded = false;

      // Hide sleep timer button with the same smooth transition as other elements
      if (this.sleepTimerButton) {
        this.sleepTimerButton.style.opacity = '0';
        this.sleepTimerButton.style.pointerEvents = 'none';
      }

      // Start fading out the sleep timer popup using CSS transitions (same as stopwatch icon)
      this.sleepTimerPopup.style.transition = 'opacity 0.3s ease';
      this.sleepTimerPopup.style.opacity = '0';

      // Prepare the active timer modal in the exact same position
      this.isActiveTimerVisible = true;
      this.activeTimerModal.classList.remove('hidden');
      this.activeTimerModal.classList.remove('translate-y-full');
      this.activeTimerModal.classList.add('translate-y-0');
      this.activeTimerModal.style.transition = 'opacity 0.3s ease';
      this.activeTimerModal.style.opacity = '0';

      // Start fading in the active timer modal after the popup has faded out
      setTimeout(() => {
        this.activeTimerModal.style.opacity = '1';
      }, 300);

      // Clean up after both transitions are complete
      setTimeout(() => {
        this.sleepTimerPopup.classList.add('hidden');
        this.sleepTimerPopup.classList.add('translate-y-full');
        this.sleepTimerPopup.classList.remove('translate-y-0');
        this.sleepTimerPopup.style.opacity = '';
        this.sleepTimerPopup.style.transition = '';
        this.activeTimerModal.style.transition = '';
      }, 600);
    }

    private startSleepTimer(minutes: number) {
      // Clear any existing timer
      this.stopSleepTimer();

      // Set the end time
      this.sleepTimerEndTime = Date.now() + (minutes * 60 * 1000);

      // Check if music is currently paused and set timer state accordingly
      const state = musicPlayer.getState();
      if (!state.isPlaying && state.currentTrack) {
        // Music is paused, start timer in paused state
        this.sleepTimerPaused = true;
        this.sleepTimerPausedAt = Date.now();
        console.log('🛌 Sleep timer started in paused state (music not playing)');
      } else {
        // Music is playing, start timer normally
        this.sleepTimerPaused = false;
        this.sleepTimerPausedAt = null;
        console.log('🛌 Sleep timer started (music playing)');
      }

      // Reset button to Cancel when starting a new timer
      this.updateTimerButton(false);

      // Save to localStorage for persistence
      this.saveSleepTimerState();

      // Start the countdown interval
      this.sleepTimerInterval = window.setInterval(() => {
        this.updateSleepTimerDisplay();
      }, 1000);

      // Update display immediately
      this.updateSleepTimerDisplay();

      console.log(`🛌 Sleep timer started for ${minutes} minutes`);
    }

    private stopSleepTimer() {
      if (this.sleepTimerInterval) {
        clearInterval(this.sleepTimerInterval);
        this.sleepTimerInterval = null;
      }
      this.sleepTimerEndTime = null;

      // Reset paused state
      this.sleepTimerPaused = false;
      this.sleepTimerPausedAt = null;

      // Clear from localStorage
      this.clearSleepTimerState();

      console.log('🛌 Sleep timer stopped');
    }

    private updateSleepTimerDisplay() {
      if (!this.sleepTimerEndTime) return;

      const countdown = document.getElementById('timer-countdown');
      if (!countdown) return;

      // If timer is paused, don't update countdown
      if (this.sleepTimerPaused) {
        return;
      }

      const now = Date.now();
      const timeLeft = Math.max(0, this.sleepTimerEndTime - now);

      if (timeLeft <= 0) {
        // Timer finished
        this.onSleepTimerComplete();
        return;
      }

      // Convert to minutes and seconds
      const totalSeconds = Math.ceil(timeLeft / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;

      countdown.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }

    private pauseSleepTimer() {
      if (!this.sleepTimerEndTime || this.sleepTimerPaused) return;

      console.log('🛌 Sleep timer paused (music paused)');
      this.sleepTimerPaused = true;
      this.sleepTimerPausedAt = Date.now();

      // Save the paused state
      this.saveSleepTimerState();
    }

    private resumeSleepTimer() {
      if (!this.sleepTimerEndTime || !this.sleepTimerPaused || !this.sleepTimerPausedAt) return;

      console.log('🛌 Sleep timer resumed (music resumed)');

      // Calculate how long we were paused and extend the end time
      const pausedDuration = Date.now() - this.sleepTimerPausedAt;
      this.sleepTimerEndTime += pausedDuration;

      // Reset paused state
      this.sleepTimerPaused = false;
      this.sleepTimerPausedAt = null;

      // Update display immediately
      this.updateSleepTimerDisplay();

      // Save the updated state
      this.saveSleepTimerState();
    }

    private onSleepTimerComplete() {
      console.log('🛌 Sleep timer completed - pausing music');

      // Stop the timer
      this.stopSleepTimer();

      // Pause the music
      musicPlayer.pause();

      // If widget is expanded, collapse it first
      if (this.isExpanded) {
        this.collapse();
        // Wait for collapse animation to complete before showing restart modal
        setTimeout(() => {
          this.showRestartModal();
        }, 350); // Slightly longer than collapse animation (300ms)
      } else {
        // If not expanded, show restart modal immediately
        this.showRestartModal();
      }

      console.log('🛌 Sleep timer completed - showing restart modal');
    }

    private showRestartModal() {
      // Update display
      const countdown = document.getElementById('timer-countdown');
      if (countdown) {
        countdown.textContent = 'Time\'s up!';
      }

      // Change cancel button to restart button
      this.updateTimerButton(true);

      // Always show the active timer modal with restart option
      this.showActiveTimerModal();
    }

    private updateTimerButton(isRestart: boolean) {
      const cancelButton = document.getElementById('cancel-timer');
      if (cancelButton) {
        cancelButton.textContent = isRestart ? 'Restart' : 'Cancel';
      }
    }

    private saveSleepTimerState() {
      if (!this.sleepTimerEndTime) return;

      try {
        const timerState = {
          endTime: this.sleepTimerEndTime,
          isActive: true,
          savedAt: Date.now(),
          lastDuration: this.lastTimerDuration,
          isPaused: this.sleepTimerPaused,
          pausedAt: this.sleepTimerPausedAt
        };
        localStorage.setItem('sleepTimerState', JSON.stringify(timerState));
      } catch (error) {
        console.warn('Failed to save sleep timer state:', error);
      }
    }

    private clearSleepTimerState() {
      try {
        localStorage.removeItem('sleepTimerState');
      } catch (error) {
        console.warn('Failed to clear sleep timer state:', error);
      }
    }

    private restoreSleepTimer() {
      try {
        const saved = localStorage.getItem('sleepTimerState');
        if (!saved) return;

        const timerState = JSON.parse(saved);
        if (!timerState.isActive || !timerState.endTime) return;

        // Check if timer is still valid (not expired)
        const now = Date.now();
        if (now >= timerState.endTime) {
          // Timer has already expired
          this.clearSleepTimerState();
          return;
        }

        // Restore the timer and last duration
        this.sleepTimerEndTime = timerState.endTime;
        this.lastTimerDuration = timerState.lastDuration || null;

        // Restore paused state
        this.sleepTimerPaused = timerState.isPaused || false;
        this.sleepTimerPausedAt = timerState.pausedAt || null;

        // Start the countdown interval
        this.sleepTimerInterval = window.setInterval(() => {
          this.updateSleepTimerDisplay();
        }, 1000);

        // Show the active timer modal
        this.showActiveTimerModal();

        // Update display immediately
        this.updateSleepTimerDisplay();

        console.log('🛌 Sleep timer restored from previous session');
      } catch (error) {
        console.warn('Failed to restore sleep timer:', error);
        this.clearSleepTimerState();
      }
    }

    private formatTime(seconds: number): string {
      return nowPlayingManager.formatTime(seconds);
    }

    public destroy() {
      if (this.footerObserver) {
        this.footerObserver.disconnect();
      }

      // Clean up sleep timer
      this.stopSleepTimer();
    }
  }

  // Global instance
  let nowPlayingWidget: NowPlayingWidget | null = null;

  // Initialize widget
  function initNowPlayingWidget() {
    if (nowPlayingWidget) {
      nowPlayingWidget.destroy();
    }
    nowPlayingWidget = new NowPlayingWidget();
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNowPlayingWidget);
  } else {
    initNowPlayingWidget();
  }

  // Also initialize on page navigation (for SPAs)
  document.addEventListener('astro:page-load', initNowPlayingWidget);
</script>

